@inproceedings{keys2026neuromechanistic,
  title        = {Neuromechanistic Shelf-Life Prediction with an Agentic, Explanation-Oriented Interface},
  author       = {Keys*, A. E. and Phillips*, S*. and Gokulakrishnan*, S*. and Antala, P. and Arnold, T. B. and Murai, F.},
  year         = {2026},
  month        = oct,
  address      = {Cambridge, MA},
  abbr         = {MIT URTC 2026},
  additional_info = {*[IEEE Explore Conference Proceedings](https://ieeexplore.ieee.org/xpl/conhome/1814684/all-proceedings) of the 2026 MIT Undergraduate Research Technology Conference [COMING SOON], Cambridge, MA*},
  note            = {Paper presented October 10, 2026.},
  abstract        = {Food safety decisions traditionally rely on static, condition-agnostic shelf-life estimates that cannot account for real-world variation in storage conditions, particularly in resource-constrained environments such as disaster relief, where both using spoiled food and needlessly discarding usable food carry serious consequences. We investigate a hybrid mechanistic-neural approach to predicting bacterial spoilage growth from food group, temperature, water activity, and pH, built on a preprocessing pipeline that consolidates multi-laboratory growth-curve data from ComBase into a benchmark of 245 curves across 22 food groups. The proposed model reduces held-out RMSE of whole-aerobic-flora count by 52.6\%, and lowers the miss rate from 0.351 to 0.188 and the false-alarm rate from 0.568 to 0.297 relative to the mechanistic baseline. To make predictions usable by non-expert decision makers, we design an LLM agentic interface that elicits storage conditions and returns audience-specific explanations. Together, these components show that correcting a biologically grounded model with learned components improves both fit and decision-relevant accuracy while retaining an interpretable mechanistic base.}
}

